# Production Environment Variables Template
# Copy this file to .env and update with your actual values
#
# Usage:
#   cp env.prod.example .env
#   # Then edit .env and set your SECRET_KEY and other values

# Django Secret Key - Generate a new one for production!
# You can generate one with: python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-this

# Debug mode - MUST be False in production
DEBUG=False

# Allowed hosts - comma-separated list of domains/IPs
# Include your domain and any IPs that might access the app
ALLOWED_HOSTS=golfcalendar.jlbrooks.tech

# Database URL - defaults to docker-compose service name
# Format: postgis://user:password@host:port/database
DATABASE_URL=postgis://postgres:postgres@db:5432/golf_calendar

